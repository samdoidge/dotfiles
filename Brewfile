# ============================================
# Brewfile - Privacy-First Mac Development Setup
# ============================================
# Install: brew bundle --file=~/.dotfiles/Brewfile
# ============================================

# ============================================
# CLI Tools
# ============================================
brew "git"                    # Version control
brew "gh"                     # GitHub CLI
brew "uv"                     # Python environment
brew "node"                   # Node.js (for Claude Code)
brew "colima"                 # Docker runtime (no telemetry)
brew "docker"                 # Docker CLI
brew "docker-compose"         # Docker Compose
brew "dockutil"               # Dock management
brew "defaultbrowser"         # Set default browser via CLI

# ============================================
# Terminal & Editor
# ============================================
cask "ghostty"                # Fast, native terminal
# cask "zed"                  # Fast, native editor (no telemetry)
cask "vscodium"               # VS Code without telemetry

# ============================================
# Browser
# ============================================
cask "brave-browser"          # Chromium-based, privacy-focused

# ============================================
# Productivity
# ============================================
cask "rectangle"              # Window management
# cask "bitwarden"              # Password manager (open-source)

# ============================================
# Privacy
# ============================================
cask "protonvpn"              # Free, no-logs VPN (Swiss)
# DNS configured in macos.sh (Cloudflare 1.1.1.1)

# ============================================
# Optional (uncomment if needed)
# ============================================
